+        return [this] (const Ev& e) { events.push_back (e); };
+    }
+    std::vector<Ev> clears() const
+    {
+        std::vector<Ev> out;
+        for (const auto& e : events)
+            if (e.kind == Ev::Kind::Clear)
+                out.push_back (e);
+        return out;
+    }
+};
+} // namespace
