+    const auto lines = linesOf (logger.currentFile());
+    ASSERT_EQ (lines.size(), 4);   // session_start, tick, tick, session_end
+    EXPECT_TRUE (parsedLine (lines[1]).hasProperty ("t"));
+    EXPECT_TRUE (parsedLine (lines[2]).hasProperty ("t"));
+}
