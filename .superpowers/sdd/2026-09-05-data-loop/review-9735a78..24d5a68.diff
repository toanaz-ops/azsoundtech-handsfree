+TEST (NotchControllerEvents, DetectorPlacementCarriesTheScoredFrameAndTheScorersReference)
+{
+    StereoHarness h; Recorder r; h.controller.setEventSink (r.sink());
+    h.controller.setDetectionActive (true);
