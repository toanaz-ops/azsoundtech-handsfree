+    o->setProperty ("device", engine_.getCurrentDeviceName());
+    o->setProperty ("sample_rate", engine_.getCurrentSampleRateHz());
+    o->setProperty ("buffer_size", engine_.getCurrentBufferSize());
+
+    juce::Array<juce::var> slots;
