+    // ... existing axis-3 code; out.mNorm = static_cast<float> (mNorm) after the clamp ...
+    // ... existing penalty code, assigning out.penalty ...
+
+    out.score = out.pNorm * out.rNorm * out.mNorm * out.penalty;
+    return out;
+}
