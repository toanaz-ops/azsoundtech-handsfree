+    ASSERT_NE (set->ctx, nullptr);
+    const auto& ctx = *set->ctx;
+    EXPECT_EQ (ctx.bins, Detector::kNumBins);
+    EXPECT_NEAR (ctx.binHz, kTestSr / Detector::kFftSize, 1e-9);
