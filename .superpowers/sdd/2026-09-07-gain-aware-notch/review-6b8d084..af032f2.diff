+    // lastDetectedMs are deliberately left alone: this is the same notch, and
+    // lane D's labels are keyed to when it was placed (B-1).
+    ev.ageMs = liveMs_ - n.lockedAtMs;
+    pushEventLocked (std::move (ev));
