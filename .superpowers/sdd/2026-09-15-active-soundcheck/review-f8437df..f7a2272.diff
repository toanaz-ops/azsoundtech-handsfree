+    // things -- one Label cannot be two sizes (ModeRail.h:66-72).
+    const auto caption = panel.progressTextForTest();
+    EXPECT_TRUE (caption.contains ("2/4"));                     // 1-based for a human
+    EXPECT_TRUE (caption.containsIgnoreCase (
