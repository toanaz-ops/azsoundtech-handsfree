+
 void Biquad::reset()
 {
     z1_ = 0.0;
     z2_ = 0.0;
     // An explicit reset is a statement that the past is gone; a ramp toward a
     // target designed against that past has nothing left to interpolate.
     rampRemaining_ = 0;
 }
