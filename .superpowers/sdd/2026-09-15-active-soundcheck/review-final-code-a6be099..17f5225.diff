+    juce::TextButton applyButton   { juce::String::fromUTF8 ("\xc3\x81P D\xe1\xbb\xa4NG") };
+    juce::TextButton dismissButton { juce::String::fromUTF8 ("B\xe1\xbb\x8e") };
